---
/** catalog: Balloon (spec/parts/balloon.md §3). Variant order/text must match reference/fixtures/balloon.html */
import Catalog from '../../layouts/Catalog.astro';
import Content from '../../components/Content.astro';
import Balloon from '../../components/Balloon.astro';
---
<Catalog title="Balloon">
  <Content data-variant="left">
    <Balloon icon="/catalog/sample.svg" name="名前">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="right">
    <Balloon icon="/catalog/sample.svg" name="名前" dir="right">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="think">
    <Balloon icon="/catalog/sample.svg" name="名前" tail="think">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="border">
    <Balloon icon="/catalog/sample.svg" name="名前" border>
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="square">
    <Balloon icon="/catalog/sample.svg" name="名前" shape="square">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="col-red">
    <Balloon icon="/catalog/sample.svg" name="名前" color="red">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="col-blue">
    <Balloon icon="/catalog/sample.svg" name="名前" color="blue">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="col-green">
    <Balloon icon="/catalog/sample.svg" name="名前" color="green">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="col-yellow">
    <Balloon icon="/catalog/sample.svg" name="名前" color="yellow">
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="think-border">
    <Balloon icon="/catalog/sample.svg" name="名前" tail="think" border>
      <p>ふきだしのテキストです。</p>
    </Balloon>
  </Content>

  <Content data-variant="rich">
    <Balloon icon="/catalog/sample.svg" name="名前" color="blue">
      <h3>ふきだし内の見出し</h3>
      <p>一つめの段落です。</p>
      <p>二つめの段落で、少し長めの文章にして折り返しの見え方も確認します。</p>
      <ul><li>リスト項目</li></ul>
    </Balloon>
  </Content>

</Catalog>
