---
/** catalog: Step (spec/parts/step.md §3). Variant order/text must match reference/fixtures/step.html */
import Catalog from '../../layouts/Catalog.astro';
import Content from '../../components/Content.astro';
import Step from '../../components/Step.astro';
import StepItem from '../../components/StepItem.astro';
---
<Catalog title="Step">
  <Content data-variant="default">
    <Step>
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="big">
    <Step variant="big" numStyle="vertical">
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="small">
    <Step variant="small">
      <StepItem title="ステップ1のタイトル" shape><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル" shape><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="num">
    <Step numStyle="num">
      <StepItem label={null} title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem label={null} title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="horizontal">
    <Step numStyle="horizontal">
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="vertical">
    <Step numStyle="vertical">
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="rich-body">
    <Step>
      <StepItem title="ステップ1のタイトル">
        <p>一つめの段落です。</p>
        <p>二つめの段落で、少し長めの文章にして折り返しの見え方も確認します。</p>
        <ul><li>リスト項目</li></ul>
      </StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="big-circle">
    <Step variant="big">
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="small-horizontal">
    <Step variant="small" numStyle="horizontal">
      <StepItem title="ステップ1のタイトル" shape><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル" shape><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="single">
    <Step>
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
  </Content>

  <Content data-variant="many">
    <Step>
      <StepItem title="ステップ1のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ2のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ3のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ4のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ5のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ6のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ7のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ8のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ9のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ10のタイトル"><p>ステップの説明文です。</p></StepItem>
      <StepItem title="ステップ11のタイトル"><p>ステップの説明文です。</p></StepItem>
    </Step>
